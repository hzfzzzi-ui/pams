{
  "meta": {
    "strategy_id": "driven_global_pullback_v1_1",
    "version": "1.1.0",
    "nav_mode": "B_NAV",
    "base_currency": "CNY",
    "timezone": "America/Mexico_City",
    "notes": "B_NAV excludes non-tradable assets (e.g., Huawei private equity, provident fund, receivables)."
  },
  "portfolio": {
    "b_nav_override_cny": 149145,
    "risk_budget": {
      "per_trade_risk_pct": {
        "defensive": 0.005,
        "attack": 0.008
      },
      "concurrent_risk_pct_cap": {
        "defensive": 0.02,
        "attack": 0.03
      },
      "theme_exposure_pct_cap": {
        "defensive": 0.25,
        "attack": 0.35
      }
    },
    "monthly_circuit_breakers": {
      "pause_new_entries_drawdown_pct": 0.04,
      "reduce_only_drawdown_pct": 0.07,
      "resume_drawdown_pct": 0.03
    },
    "cash_buffer": {
      "enabled": true,
      "rule": "max(MonthlyOverseasDCA_CNY + MonthlyFixedRent_CNY, 0.08 * B_NAV)",
      "monthly_overseas_dca_mxn": 50000,
      "monthly_fixed_rent_mxn": 25000,
      "fx_sources": [
        "XE",
        "Wise"
      ]
    },
    "limits": {
      "max_positions_total": 12,
      "max_attack_positions": 2,
      "max_single_position_value_pct": {
        "equity": 0.08,
        "etf": 0.1
      },
      "max_crypto_total_pct": 0.1,
      "max_crypto_single_pct": 0.04
    }
  },
  "core_policy": {
    "benchmark": {
      "type": "index",
      "symbol": "SPX",
      "data_source": "Bloomberg_or_Stooq"
    },
    "trend_filter": {
      "bar": "1M",
      "ma_months": 10,
      "hysteresis_months": 2,
      "states": [
        "RISK_ON",
        "RISK_NEUTRAL",
        "RISK_OFF"
      ]
    },
    "alloc_bands": {
      "RISK_ON": {
        "core_pct": [
          0.6,
          0.7
        ],
        "satellite_pct": [
          0.2,
          0.3
        ],
        "venture_pct": [
          0.05,
          0.1
        ],
        "cash_defensive_pct_min": 0.05
      },
      "RISK_NEUTRAL": {
        "core_pct": [
          0.55,
          0.65
        ],
        "satellite_pct": [
          0.2,
          0.25
        ],
        "venture_pct": [
          0.05,
          0.08
        ],
        "cash_defensive_pct_min": 0.08
      },
      "RISK_OFF": {
        "core_pct": [
          0.45,
          0.55
        ],
        "satellite_pct": [
          0.1,
          0.2
        ],
        "venture_pct": [
          0.0,
          0.05
        ],
        "cash_defensive_pct_min": 0.2
      }
    },
    "overseas_core_instruments": {
      "preferred_structure": "UCITS_ACC",
      "candidates": [
        {
          "role": "US_BROAD",
          "examples": [
            "CSPX"
          ],
          "venue_priority": [
            "LSEETF_USD",
            "XETRA_EUR"
          ]
        },
        {
          "role": "GLOBAL_BROAD",
          "examples": [
            "VWRA"
          ],
          "venue_priority": [
            "LSEETF_USD"
          ]
        },
        {
          "role": "GOLD",
          "examples": [
            "IGLN"
          ],
          "venue_priority": [
            "LSEETF_USD"
          ]
        },
        {
          "role": "DEFENSIVE_CASH",
          "examples": [
            "USD_CASH_OR_MONEY_MARKET"
          ],
          "venue_priority": [
            "IBKR"
          ]
        }
      ]
    },
    "dry_powder": {
      "target_pct_of_overseas_assets": {
        "RISK_ON": 0.2,
        "RISK_NEUTRAL": 0.25,
        "RISK_OFF": 0.3
      },
      "deploy_rules": [
        {
          "trigger": "index_drawdown_from_peak_pct >= 0.10",
          "deploy_pct_of_dry_powder": 0.25
        },
        {
          "trigger": "index_drawdown_from_peak_pct >= 0.20",
          "deploy_pct_of_dry_powder": 0.35
        },
        {
          "trigger": "index_drawdown_from_peak_pct >= 0.30",
          "deploy_pct_of_dry_powder": 0.4
        }
      ]
    }
  },
  "satellite_cn": {
    "enabled": true,
    "holding_period_days": [
      10,
      30
    ],
    "universe": {
      "market": "CN_A",
      "liquidity_floor": {
        "avg_turnover_20d_cny": 200000000
      },
      "exclude": {
        "st": true,
        "delisting_risk": true,
        "long_suspension": true
      },
      "blacklist_rules": {
        "pledge_ratio_high": {
          "enabled": true,
          "threshold_pct": 50
        },
        "frequent_penalties": {
          "enabled": true
        },
        "large_goodwill_risk": {
          "enabled": true
        },
        "financial_fraud_flags": {
          "enabled": true
        }
      }
    },
    "fundamental_gate": {
      "enabled": true,
      "quality_score_range": [
        0,
        100
      ],
      "hold_bias_values": [
        0,
        1
      ],
      "signals": {
        "cashflow_trend": {
          "enabled": true,
          "lookback_quarters": 8,
          "rule": "no_persistent_deterioration"
        },
        "industry_regime": {
          "enabled": true,
          "proxy_index": "industry_index_trend",
          "rule": "not_in_clear_downtrend"
        },
        "event_risks": {
          "enabled": true,
          "watch": [
            "preloss_warning",
            "investigation",
            "major_penalty",
            "abnormal_suspension"
          ]
        }
      }
    },
    "technical_engine": {
      "enabled": true,
      "scan_schedule": {
        "eod_scan": true,
        "intraday_refresh": {
          "enabled": true,
          "interval_minutes": 15,
          "only_for_candidates": true
        }
      },
      "trend_gate": {
        "bar": "1D",
        "ma_short": 20,
        "ma_long": 60,
        "require": [
          "MA20 > MA60",
          "CLOSE > MA60",
          "MAX_RETURN_40D >= 0.12"
        ],
        "reject_if": [
          "ABS(MA20 - MA60)/CLOSE < 0.015"
        ]
      },
      "pullback_setup": {
        "lookback_high_days": 20,
        "atr_period": 14,
        "pullback_zone": {
          "center": "MA20",
          "band_atr": 1.0
        },
        "invalidation": [
          "LOW < MA60"
        ],
        "trigger_day": [
          "CLOSE > MA20",
          "CLOSE > OPEN"
        ],
        "entry": {
          "type": "LIMIT",
          "price_ref": "CLOSE_D",
          "price_offset_pct": -0.002
        },
        "valid_until_days": 2
      },
      "stop": {
        "method": "min_of_two",
        "rule_a": {
          "type": "ATR_MULT",
          "mult": 2.0,
          "ref": "ENTRY"
        },
        "rule_b": {
          "type": "PULLBACK_LOW_MINUS_ATR",
          "mult": 0.5,
          "ref": "PULLBACK_LOW"
        }
      }
    },
    "flow_confirm": {
      "enabled": true,
      "metrics": {
        "pullback_volume_vs_impulse": {
          "rule": "AVG_VOL_PULLBACK < AVG_VOL_IMPULSE"
        },
        "trigger_day_volume_pop": {
          "rule": "VOL_D > AVG_VOL_PULLBACK * 1.2"
        },
        "hard_fail_big_red": {
          "rule": "EXISTS(DAY_RET < -0.025 AND VOL > AVG_VOL_IMPULSE)"
        }
      },
      "mapping": {
        "PASS": {
          "score": 75,
          "conditions": [
            "pullback_volume_vs_impulse",
            "trigger_day_volume_pop"
          ]
        },
        "WEAK": {
          "score": 60,
          "conditions": [
            "pullback_volume_vs_impulse OR trigger_day_volume_pop"
          ]
        },
        "FAIL": {
          "score": 0,
          "conditions": [
            "hard_fail_big_red"
          ]
        }
      }
    },
    "sentiment": {
      "enabled": true,
      "states": [
        "HOT",
        "NEUTRAL",
        "PANIC"
      ],
      "sources": {
        "market_breadth": {
          "enabled": true,
          "inputs": [
            "advancers_decliners",
            "limit_up_down_counts",
            "index_big_red_freq"
          ]
        },
        "news_providers": {
          "enabled": true,
          "inputs": [
            "Bloomberg",
            "Jin10",
            "Caixin",
            "SinaFinance",
            "Eastmoney"
          ]
        },
        "search_trends": {
          "enabled": true,
          "inputs": [
            "BaiduIndex",
            "WeChatIndex",
            "GoogleTrends"
          ],
          "topk_topics": 10
        },
        "social_heat": {
          "enabled": true,
          "inputs": [
            "X",
            "Weibo",
            "Reddit_optional"
          ],
          "topk_topics": 10
        }
      },
      "rules": {
        "HOT": {
          "position_cap_multiplier": 0.5
        },
        "PANIC": {
          "requires_flow_confirm": "PASS",
          "risk_mode_force": "defensive"
        }
      },
      "scoring": {
        "sent_score_map": {
          "HOT": 55,
          "NEUTRAL": 70,
          "PANIC": 50
        }
      }
    },
    "hard_veto": {
      "enabled": true,
      "rules": [
        "LOW < MA60 AND VOL_SPIKE",
        "CLOSE_D < PULLBACK_ZONE_LOWER",
        "MAJOR_NEGATIVE_EVENT_WITHIN_TPLUS1",
        "CONSECUTIVE_LIMIT_DOWN_OR_LIQUIDITY_CRASH",
        "SENT_PANIC_AND_INDEX_BREAKDOWN",
        "BLACKLIST_ACTIVE"
      ]
    },
    "confirm_score": {
      "enabled": true,
      "weights": {
        "flow": 0.5,
        "sent": 0.3,
        "fundamental": 0.2
      },
      "thresholds": {
        "reject": 55,
        "half_size": [
          55,
          70
        ],
        "normal_size": [
          70,
          85
        ],
        "attack_size": 85
      }
    },
    "positioning": {
      "risk_mode_default": "defensive",
      "attack_switch": {
        "enabled": true,
        "conditions": [
          "CORE_STATE == RISK_ON",
          "SENT_STATE != HOT",
          "LAST20_TRADES_WINRATE >= 0.50",
          "LAST20_TRADES_PAYOFF >= 1.2",
          "CURRENT_DRAWDOWN < 0.05"
        ]
      },
      "two_attack_names": [
        "ATTACK_A",
        "ATTACK_B"
      ],
      "max_attack_positions": 2,
      "observation_position_value_pct_cap": 0.02,
      "cooldowns": {
        "after_stop_days": 5,
        "two_stops_blacklist_days": 20
      }
    }
  },
  "satellite_overseas_stocks": {
    "enabled": true,
    "apply_same_framework_as_cn": true,
    "differences": {
      "bars": {
        "trend": "1D",
        "core_trend": "1M"
      },
      "liquidity_floor": {
        "avg_dollar_volume_20d_usd": 20000000
      },
      "sentiment_sources_weight": {
        "Bloomberg": 0.4,
        "SEC_filings": 0.2,
        "earnings_transcript": 0.2,
        "search_trends": 0.2
      }
    }
  },
  "venture_crypto": {
    "enabled": true,
    "universe": {
      "allowed": [
        "BTC",
        "ETH"
      ],
      "max_extra": 5,
      "fixed_list": true
    },
    "risk": {
      "per_trade_risk_pct": 0.003,
      "max_single_pct": 0.04,
      "max_total_pct": 0.1
    },
    "technical": {
      "use_pullback": true,
      "ma_short": 20,
      "ma_long": 60,
      "atr_period": 14,
      "valid_until_days": 2
    },
    "flow_sentiment": {
      "funding_rate": {
        "hot_threshold": 0.0008,
        "action": "block_or_half"
      },
      "open_interest": {
        "oi_spike_pct": 0.15,
        "price_stall_bars": 6,
        "action": "de_risk"
      }
    },
    "circuit_breakers": {
      "pause_new_entries_drawdown_pct": 0.04,
      "reduce_only_drawdown_pct": 0.07
    }
  },
  "execution": {
    "order_draft_required_fields": [
      "b_nav",
      "risk_mode",
      "max_loss_cny",
      "entry",
      "stop",
      "valid_until",
      "position_size",
      "position_value_pct",
      "risk_amount_cny",
      "concurrent_risk_after",
      "flow_confirm",
      "sent_state",
      "eligible",
      "quality_score",
      "hard_veto_hit",
      "reason_codes"
    ],
    "venues": {
      "CN_A": {
        "broker": "THS_or_BrokerAPI",
        "manual_confirm": true
      },
      "US_STOCKS": {
        "broker": "IBKR",
        "manual_confirm": true
      },
      "CRYPTO": {
        "broker": "Binance",
        "manual_confirm": false,
        "kill_switch": true
      }
    }
  },
  "data_sources": {
    "pricing_cn": [
      "TusharePro",
      "AkShare",
      "Eastmoney",
      "JoinQuant_optional"
    ],
    "fundamentals_cn": [
      "TusharePro",
      "Eastmoney_financials",
      "Wind_optional"
    ],
    "announcements_cn": [
      "CNINFO",
      "SSE_SZSE_feeds",
      "Eastmoney_announcements"
    ],
    "northbound_flow_cn": [
      "Eastmoney_northbound",
      "Wind_optional"
    ],
    "pricing_us": [
      "IBKR_marketdata",
      "Polygon_optional",
      "Stooq_fallback"
    ],
    "fundamentals_us": [
      "SEC_EDGAR",
      "company_IR",
      "earnings_transcripts_provider"
    ],
    "macro_news": [
      "Bloomberg",
      "Reuters",
      "Jin10",
      "Caixin"
    ],
    "search_trends": [
      "BaiduIndex",
      "WeChatIndex",
      "GoogleTrends"
    ],
    "social": [
      "X",
      "Weibo",
      "Reddit_optional"
    ],
    "crypto": [
      "Binance_API",
      "Coinglass_optional",
      "CryptoCompare_optional"
    ]
  }
}