{
  "meta": {
    "version": "1.2",
    "strategy_id": "driven_global_pullback_v1_2",
    "base_currency": "CNY",
    "nav_mode": "B_NAV",
    "timezone": "America/Mexico_City",
    "notes": "v1.2: 期望值优先、回踩主导。RS过滤+时序解耦+Distribution Day+结构止损+时间止损+分段止盈。",
    "price_policy": {
      "execution_price_mode": "RAW_ONLY",
      "indicator_price_mode": "QFQ_FOR_MA_ATR"
    },
    "changelog": {
      "v1.2": [
        "趋势门: +MA20_slope>0, +RS>=0 vs HS300, 移除MAX_RETURN_40D, tangle松至0.008",
        "回踩时序解耦: 5日touch + 当日trigger，触发不要求仍在zone内",
        "flow_confirm: +Distribution Day否决, peak排除trigger day",
        "止损: max(struct, atr) → 更紧, ATR mult 2.2, >12%拒绝",
        "时间止损: 7日无+0.8R退出",
        "分段止盈: 1R减1/3+保本, 2R减1/3, 剩余trailing",
        "风控: 3%单笔, 6%/9%并发, 10%单票, lot rounding校验"
      ]
    }
  },
  "core_policy": {
    "trend_filter": {
      "bar": "1M",
      "ma_months": 10,
      "hysteresis_months": 2,
      "states": ["RISK_ON", "RISK_NEUTRAL", "RISK_OFF"]
    },
    "benchmark": {
      "symbol": "SPX",
      "type": "index",
      "data_source": "Bloomberg_or_Stooq"
    },
    "alloc_bands": {
      "RISK_ON": {
        "core_pct": [0.60, 0.70],
        "satellite_pct": [0.20, 0.30],
        "venture_pct": [0.05, 0.10],
        "cash_defensive_pct_min": 0.05
      },
      "RISK_NEUTRAL": {
        "core_pct": [0.55, 0.65],
        "satellite_pct": [0.20, 0.25],
        "venture_pct": [0.05, 0.08],
        "cash_defensive_pct_min": 0.08
      },
      "RISK_OFF": {
        "core_pct": [0.45, 0.55],
        "satellite_pct": [0.10, 0.20],
        "venture_pct": [0.00, 0.05],
        "cash_defensive_pct_min": 0.20
      }
    },
    "dry_powder": {
      "target_pct_of_overseas_assets": {
        "RISK_ON": 0.20,
        "RISK_NEUTRAL": 0.25,
        "RISK_OFF": 0.30
      },
      "deploy_rules": [
        {"trigger": "index_drawdown_from_peak_pct >= 0.10", "deploy_pct_of_dry_powder": 0.25},
        {"trigger": "index_drawdown_from_peak_pct >= 0.20", "deploy_pct_of_dry_powder": 0.35},
        {"trigger": "index_drawdown_from_peak_pct >= 0.30", "deploy_pct_of_dry_powder": 0.40}
      ]
    }
  },
  "portfolio": {
    "b_nav_override_cny": 149145,
    "risk_budget": {
      "per_trade_risk_pct": {
        "defensive": 0.03,
        "attack": 0.03
      },
      "concurrent_risk_pct_cap": {
        "defensive": 0.06,
        "attack": 0.09
      },
      "theme_exposure_pct_cap": {
        "defensive": 0.25,
        "attack": 0.35
      }
    },
    "limits": {
      "max_positions_total": 12,
      "max_attack_positions": 2,
      "max_single_position_value_pct": {
        "equity": 0.10,
        "etf": 0.10
      },
      "max_crypto_single_pct": 0.04,
      "max_crypto_total_pct": 0.10
    },
    "monthly_circuit_breakers": {
      "pause_new_entries_drawdown_pct": 0.04,
      "reduce_only_drawdown_pct": 0.07,
      "resume_drawdown_pct": 0.03
    },
    "cash_buffer": {
      "enabled": true,
      "rule": "max(MonthlyOverseasDCA_CNY + MonthlyFixedRent_CNY, 0.08 * B_NAV)",
      "monthly_overseas_dca_mxn": 50000,
      "monthly_fixed_rent_mxn": 25000,
      "fx_sources": ["XE", "Wise"]
    }
  },
  "satellite_cn": {
    "enabled": true,
    "universe": {
      "market": "CN_A",
      "exclude": {
        "st": true,
        "delisting_risk": true,
        "long_suspension": true
      },
      "liquidity_floor": {
        "avg_turnover_20d_cny": 200000000
      },
      "blacklist_rules": {
        "pledge_ratio_high": {"enabled": true, "threshold_pct": 50},
        "financial_fraud_flags": {"enabled": true},
        "frequent_penalties": {"enabled": true},
        "large_goodwill_risk": {"enabled": true}
      }
    },
    "technical_engine": {
      "enabled": true,
      "rs_benchmark": {
        "index_code": "sh000300",
        "lookback_days": 60,
        "min_rs": 0.0
      },
      "trend_gate": {
        "bar": "1D",
        "ma_short": 20,
        "ma_long": 60,
        "require": [
          "MA20 > MA60",
          "CLOSE > MA60",
          "MA20_SLOPE > 0",
          "RS >= 0 vs HS300"
        ],
        "reject_if": [
          "ABS(MA20 - MA60)/CLOSE < 0.008"
        ],
        "ma_tangle_threshold": 0.008,
        "ma20_slope_lookback": 5
      },
      "pullback_setup": {
        "pullback_zone": {
          "center": "MA20",
          "band_atr": 1.0
        },
        "touch_ref": "LOW",
        "touch_window_days": 5,
        "trigger_day": [
          "CLOSE > MA20",
          "CLOSE > OPEN"
        ],
        "trigger_requires_in_zone": false,
        "invalidation": ["LOW < MA60"],
        "entry": {
          "type": "LIMIT",
          "price_ref": "CLOSE_D",
          "price_offset_pct": -0.002
        },
        "valid_until_days": 2,
        "valid_until_trading_days": true,
        "atr_period": 14,
        "lookback_high_days": 20
      },
      "stop": {
        "method": "max_of_two",
        "rule_a": {
          "type": "ATR_MULT",
          "ref": "ENTRY",
          "mult": 2.2
        },
        "rule_b": {
          "type": "PULLBACK_LOW_MINUS_ATR",
          "ref": "PULLBACK_LOW_5D",
          "mult": 0.5
        },
        "max_stop_distance_pct": 0.12
      },
      "exit": {
        "time_stop": {
          "enabled": true,
          "max_days": 7,
          "min_r_multiple": 0.8,
          "note": "N个交易日内未达+0.8R则退出"
        },
        "partial_profit": {
          "enabled": true,
          "r1": {
            "r_multiple": 1.0,
            "sell_fraction": 0.33,
            "move_stop_to_entry": true
          },
          "r2": {
            "r_multiple": 2.0,
            "sell_fraction": 0.33
          },
          "remainder": "trailing_stop"
        },
        "trailing_stop": {
          "atr_mult": 1.5,
          "ref": "PEAK_PRICE"
        }
      },
      "scan_schedule": {
        "eod_scan": true,
        "intraday_refresh": {
          "enabled": true,
          "interval_minutes": 15,
          "only_for_candidates": true
        }
      }
    },
    "flow_confirm": {
      "enabled": true,
      "peak_exclude_trigger_day": true,
      "distribution_day": {
        "enabled": true,
        "vol_multiplier": 1.3,
        "note": "close<open AND vol>avg_vol_20d*1.3 → FAIL"
      },
      "metrics": {
        "pullback_volume_vs_impulse": {
          "rule": "AVG_VOL_PULLBACK < AVG_VOL_IMPULSE"
        },
        "trigger_day_volume_pop": {
          "rule": "VOL_D > AVG_VOL_PULLBACK * 1.2"
        },
        "hard_fail_big_red": {
          "rule": "EXISTS(DAY_RET < -0.025 AND VOL > AVG_VOL_IMPULSE)"
        }
      },
      "mapping": {
        "PASS": {"conditions": ["pullback_volume_vs_impulse", "trigger_day_volume_pop"], "score": 75},
        "WEAK": {"conditions": ["pullback_volume_vs_impulse OR trigger_day_volume_pop"], "score": 60},
        "FAIL": {"conditions": ["hard_fail_big_red", "distribution_day"], "score": 0}
      }
    },
    "fundamental_gate": {
      "enabled": true,
      "quality_score_range": [0, 100],
      "hold_bias_values": [0, 1],
      "signals": {
        "cashflow_trend": {"enabled": true, "lookback_quarters": 8, "rule": "no_persistent_deterioration"},
        "industry_regime": {"enabled": true, "proxy_index": "industry_index_trend", "rule": "not_in_clear_downtrend"},
        "event_risks": {"enabled": false, "watch": ["preloss_warning", "investigation", "major_penalty", "abnormal_suspension"]}
      }
    },
    "hard_veto": {
      "enabled": true,
      "rules": [
        "LOW < MA60 AND VOL_SPIKE",
        "CLOSE_D < PULLBACK_ZONE_LOWER",
        "CONSECUTIVE_LIMIT_DOWN_OR_LIQUIDITY_CRASH",
        "SENT_PANIC_AND_INDEX_BREAKDOWN",
        "BLACKLIST_ACTIVE"
      ]
    },
    "sentiment": {
      "enabled": true,
      "states": ["HOT", "NEUTRAL", "PANIC"],
      "scoring": {
        "sent_score_map": {"HOT": 62, "NEUTRAL": 70, "PANIC": 50}
      },
      "rules": {
        "HOT": {"position_cap_multiplier": 0.5},
        "PANIC": {"risk_mode_force": "defensive", "requires_flow_confirm": "PASS"}
      },
      "sources": {
        "market_breadth": {"enabled": true, "inputs": ["advancers_decliners", "limit_up_down_counts", "index_big_red_freq"]},
        "social_heat": {"enabled": false, "inputs": ["X", "Weibo", "Reddit_optional"], "topk_topics": 10},
        "search_trends": {"enabled": false, "inputs": ["BaiduIndex", "WeChatIndex", "GoogleTrends"], "topk_topics": 10},
        "news_providers": {"enabled": false, "inputs": ["Bloomberg", "Jin10", "Caixin", "SinaFinance", "Eastmoney"]}
      }
    },
    "confirm_score": {
      "enabled": true,
      "weights": {"flow": 0.5, "fundamental": 0.2, "sent": 0.3},
      "thresholds": {
        "attack_size": 85,
        "normal_size": [70, 85],
        "half_size": [55, 70],
        "reject": 55
      }
    },
    "positioning": {
      "risk_mode_default": "defensive",
      "max_attack_positions": 2,
      "two_attack_names": ["ATTACK_A", "ATTACK_B"],
      "observation_position_value_pct_cap": 0.02,
      "attack_switch": {
        "enabled": true,
        "min_trades_for_attack": 20,
        "conditions": [
          "CORE_STATE == RISK_ON",
          "SENT_STATE != HOT",
          "LAST20_TRADES_WINRATE >= 0.50",
          "LAST20_TRADES_PAYOFF >= 1.2",
          "CURRENT_DRAWDOWN < 0.05"
        ]
      },
      "cooldowns": {
        "after_stop_days": 5,
        "two_stops_blacklist_days": 20
      },
      "lot_rounding": {
        "enabled": true,
        "max_excess_multiplier": 1.2,
        "note": "100股取整后actual_risk > budget*1.2 → 降1手或拒绝"
      }
    },
    "holding_period_days": [10, 30]
  },
  "execution": {
    "venues": {
      "CN_A": {"broker": "THS_or_BrokerAPI", "manual_confirm": true},
      "US_STOCKS": {"broker": "IBKR", "manual_confirm": true},
      "CRYPTO": {"broker": "Binance", "manual_confirm": false, "kill_switch": true}
    },
    "order_draft_required_fields": [
      "b_nav", "risk_mode", "max_loss_cny", "entry", "stop",
      "valid_until", "position_size", "position_value_pct",
      "risk_amount_cny", "concurrent_risk_after",
      "flow_confirm", "sent_state", "eligible",
      "quality_score", "hard_veto_hit", "reason_codes"
    ]
  }
}
