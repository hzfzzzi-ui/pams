{
  # LAN-only, HTTP only for now
  auto_https off
}

# Main entry - PAMS Dashboard
http://pams.local {
  # API routes -> FastAPI backend (port 8000 inside container)
  # API routers expect the /api prefix.
  handle /api/* {
    reverse_proxy pams-api:8000 {
      transport http {
        response_header_timeout 3600s
      }
    }
  }

  # Preserve existing non-/api dashboard routes.
  @legacy_api {
    path /summary2/* /nav/* /risk/* /holdings/* /cashflow/* /investment/* /health
  }
  handle @legacy_api {
    reverse_proxy pams-api:8000 {
      transport http {
        response_header_timeout 3600s
      }
    }
  }

  # Retired endpoints must not fall back to the frontend application.
  @retired_strategy {
    path /policy /policy/* /watchlist /watchlist/*
  }
  handle @retired_strategy {
    respond 404
  }

  # Frontend static files -> Nginx
  handle {
    reverse_proxy pams-web:80
  }
}

# DNS admin UI (optional to expose)
http://adguard.pams.local {
  reverse_proxy adguard:80
}

# Default site for IP access (192.168.0.143)
:80 {
  # API routes -> FastAPI backend
  handle /api/* {
    reverse_proxy pams-api:8000 {
      transport http {
        response_header_timeout 3600s
      }
    }
  }

  @legacy_api {
    path /summary2/* /nav/* /risk/* /holdings/* /cashflow/* /investment/* /health
  }
  handle @legacy_api {
    reverse_proxy pams-api:8000 {
      transport http {
        response_header_timeout 3600s
      }
    }
  }

  # Retired endpoints must not fall back to the frontend application.
  @retired_strategy {
    path /policy /policy/* /watchlist /watchlist/*
  }
  handle @retired_strategy {
    respond 404
  }

  # Frontend static files -> Nginx
  handle {
    reverse_proxy pams-web:80
  }
}
