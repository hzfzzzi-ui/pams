# PAMS .gitignore

# 环境变量和密钥
.env
.env.local
.env.*.local
secrets/

# 数据库文件
*.sqlite3
*.db
data/*.sqlite3
data/*.db

# 运行时数据
data/
*.log

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude
.claude/

# Docker
*.pid
*.seed
*.log

# 临时文件
tmp/
temp/
*.tmp

# 备份文件
*.bak
*~

# 归档文件（可选，如果想提交归档则移除此行）
# archive/

# 测试文件
test-*.json
*.test.json

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Frontend build
dist/
.cache/

# Uploads
uploads/
inbox/screenshots/*
!inbox/screenshots/README.md

# 大文件（如需要可以用Git LFS）
*.zip
*.tar.gz
*.rar
