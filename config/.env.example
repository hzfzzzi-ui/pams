# Copy to .env and fill
POSTGRES_PASSWORD=change_me

# Firefly III uses a 32-char base64 app key. Generate:
#  - Linux/macOS:  openssl rand -base64 32
#  - Windows PS:   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
FIREFLY_APP_KEY=base64:REPLACE_ME

# Firefly DB creds (can share postgres instance; simplest is separate DB in same postgres)
FIREFLY_DB_DATABASE=pams
FIREFLY_DB_USERNAME=pams
FIREFLY_DB_PASSWORD=change_me

# Firefly personal access token (create in Firefly UI once up)
FIREFLY_TOKEN=

# Binance API (recommend READ-ONLY)
BINANCE_API_KEY=
BINANCE_API_SECRET=
